    {
      "parameters": {
        "jsCode": "const lead = $('Use Existing Contact').isExecuted\n  ? $('Use Existing Contact').first().json\n  : $('Use Created Contact').first().json;\n\nconst opportunities = Array.isArray($json.opportunities)\n  ? $json.opportunities\n  : [];\n\nconst existing = opportunities.find(opportunity => {\n  const customFields = Array.isArray(opportunity.customFields)\n    ? opportunity.customFields\n    : [];\n\n  return customFields.some(field => {\n    const value =\n      field.fieldValueString ??\n      field.fieldValue ??\n      field.value ??\n      '';\n\n    return (\n      String(field.id) === String(lead.externalLeadIdFieldId) &&\n      String(value) === String(lead.externalLeadId)\n    );\n  });\n});\n\nreturn [{\n  json: {\n    ...lead,\n    duplicateFound: Boolean(existing),\n    existingOpportunityId: existing?.id ?? null,\n  },\n}];"
      },
