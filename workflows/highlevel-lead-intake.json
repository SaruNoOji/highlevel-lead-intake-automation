        "jsCode": "const found = $json.contact ?? $json.contacts?.[0] ?? $json;\nconst lead = $('Normalize and Validate').first().json;\nif (!found?.id) throw new Error('HighLevel contact search returned an unexpected response');\nreturn [{ json: { ...lead, contactId: found.id, contactCreated: false } }];"
      },
