      "parameters": {
        "jsCode": "const required = {\n  locationId: $json.locationId,\n  pipelineId: $json.pipelineId,\n  stageId: $json.stageId,\n  serviceInterestFieldId: $json.serviceInterestFieldId,\n  externalLeadIdFieldId: $json.externalLeadIdFieldId,\n};\nconst missing = Object.entries(required)\n  .filter(([, value]) => !value || String(value).startsWith('YOUR_'))\n  .map(([name]) => name);\nif (missing.length) {\n  throw new Error('Configure HighLevel IDs before activation: ' + missing.join(', '));\n}\nreturn $input.all();"
