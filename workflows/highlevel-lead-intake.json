    {
      "parameters": {
        "jsCode": "const raw = $json.body ?? $json;\nconst clean = v => typeof v === 'string' ? v.trim() : '';\nconst email = clean(raw.email).toLowerCase();\nconst phone = clean(raw.phone);\nconst firstName = clean(raw.firstName ?? raw.first_name);\nconst lastName = clean(raw.lastName ?? raw.last_name);\nconst fullName = clean(raw.name) || [firstName, lastName].filter(Boolean).join(' ');\nconst externalLeadId = clean(raw.externalLeadId ?? raw.external_lead_id ?? raw.leadId ?? raw.lead_id);\nconst serviceInterest = clean(raw.serviceInterest ?? raw.service_interest ?? raw.service);\nconst source = clean(raw.source) || 'Website webhook';\nconst errors = [];\nif (!externalLeadId) errors.push('externalLeadId is required');\nif (!serviceInterest) errors.push('serviceInterest is required');\nif (!email && !phone) errors.push('email or phone is required');\nif (email && !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) errors.push('email format is invalid');\nif (!fullName) errors.push('name or firstName/lastName is required');\nreturn [{ json: {\n  locationId: 'YOUR_GHL_LOCATION_ID',\n  pipelineId: 'YOUR_GHL_PIPELINE_ID',\n  stageId: 'YOUR_GHL_STAGE_ID',\n  serviceInterestFieldId: 'YOUR_SERVICE_INTEREST_FIELD_ID',\n  externalLeadIdFieldId: 'YOUR_EXTERNAL_LEAD_ID_FIELD_ID',\n  email, phone, firstName, lastName, name: fullName, externalLeadId, serviceInterest, source,\n  companyName: clean(raw.companyName ?? raw.company_name),\n  monetaryValue: Number.isFinite(Number(raw.monetaryValue ?? raw.monetary_value)) ? Number(raw.monetaryValue ?? raw.monetary_value) : 0,\n  validationErrors: errors\n} }];"
